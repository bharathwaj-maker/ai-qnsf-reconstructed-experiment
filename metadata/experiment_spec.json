{
  "project": "AI-QNSF reconstructed synthetic feature-level experiment",
  "version": "1.0.0",
  "provenance": "New reconstruction from the manuscript's written methodology; not the unarchived original experiment",
  "primary_generator": {"rows": 36000, "runs": 120, "runs_per_scenario": 20, "observations_per_run": 300, "seed": 20261104, "attack_event_duration_seconds": "25-100"},
  "independent_generator": {"rows": 54000, "runs": 180, "runs_per_scenario": 30, "observations_per_run": 300, "seed": 20261105, "attack_event_duration_seconds": "30-115"},
  "model_features": ["qber", "key_rate", "channel_loss", "detector_efficiency", "dark_count_rate", "authentication_failures", "configuration_events", "latency_ms", "synchronisation_error", "telemetry_missing_fraction", "telemetry_age_ms", "channel_noise", "optical_power"],
  "excluded_metadata": ["run_id", "time_index", "distance_km", "scenario", "label"],
